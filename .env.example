# Salin ke .env lalu jalankan `npm run secrets:dev` untuk mengganti semua nilai "change-me"
# dengan secret acak. Nilai placeholder membuat /health merah dan aplikasi menolak start di produksi (src/instrumentation.ts).

# --- Aplikasi ---
NODE_ENV=development
APP_URL=http://localhost:3100
APP_HOST=localhost:3100
TRUST_PROXY=false
# ≥ 32 karakter; beberapa nilai dipisah koma untuk rotasi (yang pertama menandatangani)
AUTH_SECRET=change-me
ALLOWED_EMAIL_DOMAINS=pcpexpress.com
MAX_UPLOAD_BYTES=1073741824
USER_STORAGE_QUOTA_BYTES=21474836480
SEED_ADMIN_EMAIL=admin@pcpexpress.com
LOG_LEVEL=debug

# --- PostgreSQL (dipakai compose dan Prisma) ---
POSTGRES_DB=data_dashboard
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://app:change-me@127.0.0.1:5433/data_dashboard

# --- Query DuckDB aplikasi (T-009) ---
# QUERY_CACHE_DIR=/var/lib/dd-query   # default: <tmp>/dd-query (per replika)
MAX_LOCAL_PARQUET_BYTES=10737418240
MAX_QUERY_CONCURRENCY=4
QUERY_MEMORY_LIMIT=1GB
QUERY_TIMEOUT_MS=30000
QUERY_RESULT_CACHE_BYTES=67108864

# --- Ekspor widget CSV/XLSX (T-017) ---
EXPORT_MAX_ROWS=1000000
EXPORT_TTL_MS=3600000
EXPORT_DEADLINE_MS=600000
EXPORT_DUCKDB_MEMORY=768MB

# --- PDF dashboard lewat renderer terpisah (T-018) ---
# App + worker: alamat renderer dan secret bersama (header x-renderer-secret, ≥ 32 karakter). Keduanya
# wajib diisi bersama; kosongkan keduanya untuk mematikan PDF (ekspor PDF → RENDERER_UNAVAILABLE).
# `npm run secrets:dev` membuat secret acak. Renderer dev: `npm run renderer`.
RENDERER_URL=http://127.0.0.1:3200
RENDERER_SECRET=change-me
# Batas satu render (POST /render sampai PDF terbaca) dan ukuran PDF maksimum (25 MB).
RENDER_TIMEOUT_MS=60000
PDF_MAX_BYTES=26214400
# Alamat app yang dibuka renderer (renderer + Secure cookie render di app). Host http TIDAK boleh
# ber-TLD HSTS preload ("app", "dev", …): Chromium memaksanya https lalu gagal — di compose pakai
# mis. http://web:3000.
APP_INTERNAL_URL=http://localhost:3100
# Renderer saja (renderer/env.ts): port, render bersamaan (1–2), tunggu halaman siap.
# RENDERER_PORT=3200
# RENDERER_CONCURRENCY=1
# Batas halaman /render siap (termasuk query widget di server). Data widget menunggu paling lama 15 s
# (BUSY_WAIT_MS, render-session.ts); jangan turunkan di bawah ± 25000. RENDER_TIMEOUT_MS > nilai ini.
# RENDER_READY_TIMEOUT_MS=30000
# Alamat dengar renderer (127.0.0.1 di host; 0.0.0.0 di kontainer jaringan render).
# RENDERER_HOST=127.0.0.1
# Hanya untuk renderer melawan `next dev` (websocket HMR); ditolak di produksi.
# ALLOW_DEV_WEBSOCKET=false

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6380/0

# --- Object storage S3 (RustFS di dev; ADR-0002). Di dev kredensial ini juga akun root RustFS. ---
S3_ENDPOINT=http://127.0.0.1:9100
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=data-dashboard
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- SMTP (Mailpit di dev) ---
SMTP_URL=smtp://127.0.0.1:2526
MAIL_FROM="Data Dashboard <no-reply@pcpexpress.com>"

# --- E2E (dev saja): aktifkan endpoint uji /api/auth/dev-bump-session ---
E2E_ENDPOINTS=0
