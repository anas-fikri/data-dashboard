FROM read_parquet($path)
WHERE (lower("c1") IN (lower($f1)) OR "c1" IS NULL)
GROUP BY lower(left("c1", 500))
ORDER BY "m0" DESC NULLS LAST, "d0" ASC NULLS LAST
LIMIT 12",
