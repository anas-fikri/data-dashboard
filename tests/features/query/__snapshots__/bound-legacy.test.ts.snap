  ) WINDOW w AS (ORDER BY k COLLATE "nocase.noaccent" ASC NULLS LAST, k ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
)
ORDER BY "m0" DESC NULLS LAST, "d0" ASC NULLS LAST
LIMIT 12",
