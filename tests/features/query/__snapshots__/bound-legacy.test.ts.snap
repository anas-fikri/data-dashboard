exports[`T-073: widget tanpa pivot tersimpan tidak berubah (SQL + kunci cache) > pivot {"dashboardFilters":[{"column":"Cabang","op":"in","values":["Jakarta"]}]} 1`] = `
{
  "keys": [
    "32c05f58ffc54bdcae84eab7c460b1057af7146e0b01f5e979a8af470a567651",
  ],
  "sql": [
    {
      "params": {
        "f1": "Reguler",
        "f2": "Jakarta",
        "path": "/tmp/t073-legacy.parquet",
      },
      "sql": "WITH s0 AS NOT MATERIALIZED (SELECT lower(left("c1", 500)) AS "k0", left("c1", 500) AS "t0", lower(left("c5", 500)) AS "k1", left("c5", 500) AS "t1", date_trunc('month', "c4") AS "kc", "c2", "c3" FROM read_parquet($path) WHERE (lower("c5") IN (lower($f1)) OR "c5" IS NULL) AND (lower("c1") IN (lower($f2)))),
top0 AS MATERIALIZED (SELECT k0, true AS hit FROM (SELECT k0, coalesce(sum("c2"), 0) AS v FROM s0 GROUP BY k0) QUALIFY row_number() OVER (ORDER BY v DESC NULLS LAST, k0 COLLATE "nocase.noaccent" ASC NULLS LAST, k0 ASC) <= 3),
src AS NOT MATERIALIZED (SELECT s.* REPLACE (CASE WHEN t.hit THEN s.k0 END AS k0, CASE WHEN t.hit THEN s.t0 END AS t0), t.hit IS NULL AS x0 FROM s0 s LEFT JOIN top0 t ON t.k0 IS NOT DISTINCT FROM s.k0),
g1 AS MATERIALIZED (SELECT g.*, row_number() OVER (ORDER BY g.x0, g.v DESC NULLS LAST, g.k0 COLLATE "nocase.noaccent" ASC NULLS LAST, g.k0 ASC) AS r FROM (SELECT k0, x0, list_sort(list_transform(map_entries(histogram("t0")), lambda x: {'n': -CAST(x.value AS BIGINT), 'k': x.key}))[1].k AS d0, coalesce(sum("c2"), 0) AS v FROM src GROUP BY k0, x0) g),
lf AS MATERIALIZED (SELECT k0, k1, x0, coalesce(sum("c2"), 0) AS v FROM src GROUP BY k0, k1, x0),
rw0 AS MATERIALIZED (SELECT lf.k0, g1.d0, lf.k1, lf.x0, row_number() OVER (ORDER BY g1.r, lf.v DESC NULLS LAST, lf.k1 COLLATE "nocase.noaccent" ASC NULLS LAST, lf.k1 ASC) AS ri, g1.r AS gi, count(*) OVER () AS n FROM lf JOIN g1 ON g1.k0 IS NOT DISTINCT FROM lf.k0 AND g1.x0 IS NOT DISTINCT FROM lf.x0 QUALIFY ri <= 200),
rws AS MATERIALIZED (SELECT rw0.*, l.d1 FROM rw0 JOIN (SELECT s.k0, s.k1, s.x0, list_sort(list_transform(map_entries(histogram(s."t1")), lambda x: {'n': -CAST(x.value AS BIGINT), 'k': x.key}))[1].k AS d1 FROM src s JOIN rw0 w ON w.k0 IS NOT DISTINCT FROM s.k0 AND w.k1 IS NOT DISTINCT FROM s.k1 AND w.x0 IS NOT DISTINCT FROM s.x0 GROUP BY s.k0, s.k1, s.x0) l ON l.k0 IS NOT DISTINCT FROM rw0.k0 AND l.k1 IS NOT DISTINCT FROM rw0.k1 AND l.x0 IS NOT DISTINCT FROM rw0.x0),
bud AS MATERIALIZED (SELECT greatest(1, count(*) + count(DISTINCT gi)) AS b FROM rws),
cols AS MATERIALIZED (SELECT kc, "kc" AS dc, row_number() OVER (ORDER BY kc ASC NULLS LAST) AS ci, count(*) OVER () AS n FROM src GROUP BY kc QUALIFY ci <= (SELECT greatest(1, least(40, 24000 // (b * 2), 16000 // b)) FROM bud)),
agg AS MATERIALIZED (SELECT r.ri AS ri, x.ci AS ci, g1x.gi AS s1, GROUPING(r.ri, x.ci, g1x.gi) AS gid, coalesce(sum("c2"), 0) AS "m0", list_filter([(list_filter([(list_filter([CAST(coalesce(sum("c2"), 0) AS DOUBLE)], lambda v: isfinite(v))[1] - list_filter([CAST(coalesce(sum("c3"), 0) AS DOUBLE)], lambda v: isfinite(v))[1])], lambda v: isfinite(v))[1] / list_filter([CAST(coalesce(sum("c2"), 0) AS DOUBLE)], lambda v: isfinite(v))[1])], lambda v: isfinite(v))[1] AS "m1" FROM src s LEFT JOIN rws r ON r.k0 IS NOT DISTINCT FROM s.k0 AND r.k1 IS NOT DISTINCT FROM s.k1 AND r.x0 IS NOT DISTINCT FROM s.x0 LEFT JOIN cols x ON x.kc IS NOT DISTINCT FROM s.kc LEFT JOIN (SELECT DISTINCT k0, x0, gi FROM rws) g1x ON g1x.k0 IS NOT DISTINCT FROM s.k0 AND g1x.x0 IS NOT DISTINCT FROM s.x0 GROUP BY GROUPING SETS ((r.ri, x.ci), (g1x.gi, x.ci), (g1x.gi), (r.ri), (x.ci), ())),
gt AS MATERIALIZED (SELECT coalesce(sum("c2"), 0) AS "m0", list_filter([(list_filter([(list_filter([CAST(coalesce(sum("c2"), 0) AS DOUBLE)], lambda v: isfinite(v))[1] - list_filter([CAST(coalesce(sum("c3"), 0) AS DOUBLE)], lambda v: isfinite(v))[1])], lambda v: isfinite(v))[1] / list_filter([CAST(coalesce(sum("c2"), 0) AS DOUBLE)], lambda v: isfinite(v))[1])], lambda v: isfinite(v))[1] AS "m1" FROM src s),
ct AS MATERIALIZED (SELECT x.ci, coalesce(sum("c2"), 0) AS "m0", list_filter([(list_filter([(list_filter([CAST(coalesce(sum("c2"), 0) AS DOUBLE)], lambda v: isfinite(v))[1] - list_filter([CAST(coalesce(sum("c3"), 0) AS DOUBLE)], lambda v: isfinite(v))[1])], lambda v: isfinite(v))[1] / list_filter([CAST(coalesce(sum("c2"), 0) AS DOUBLE)], lambda v: isfinite(v))[1])], lambda v: isfinite(v))[1] AS "m1" FROM src s JOIN cols x ON x.kc IS NOT DISTINCT FROM s.kc GROUP BY x.ci),
u AS (SELECT 'row' AS "kind", ri AS "ri", gi AS "gi", NULL AS "ci", d0 AS "d0", d1 AS "d1", NULL AS "dc", n AS "n", NULL AS "lv", NULL AS "g2", NULL AS "g3", NULL AS "d2", NULL AS "d3", CASE WHEN x0 THEN 1 ELSE 0 END AS "ox", NULL AS "m0", NULL AS "m1" FROM rws
UNION ALL
SELECT 'col' AS "kind", NULL AS "ri", NULL AS "gi", ci AS "ci", NULL AS "d0", NULL AS "d1", dc AS "dc", n AS "n", NULL AS "lv", NULL AS "g2", NULL AS "g3", NULL AS "d2", NULL AS "d3", NULL AS "ox", NULL AS "m0", NULL AS "m1" FROM cols
UNION ALL
SELECT 'cell' AS "kind", ri AS "ri", NULL AS "gi", ci AS "ci", NULL AS "d0", NULL AS "d1", NULL AS "dc", NULL AS "n", NULL AS "lv", NULL AS "g2", NULL AS "g3", NULL AS "d2", NULL AS "d3", NULL AS "ox", "m0", "m1" FROM agg WHERE gid = 1 AND ri IS NOT NULL AND ci IS NOT NULL
UNION ALL
SELECT 'sub' AS "kind", NULL AS "ri", s1 AS "gi", ci AS "ci", NULL AS "d0", NULL AS "d1", NULL AS "dc", NULL AS "n", 1 AS "lv", NULL AS "g2", NULL AS "g3", NULL AS "d2", NULL AS "d3", NULL AS "ox", "m0", "m1" FROM agg WHERE gid = 4 AND s1 IS NOT NULL AND ci IS NOT NULL
UNION ALL
SELECT 'subtot' AS "kind", NULL AS "ri", s1 AS "gi", NULL AS "ci", NULL AS "d0", NULL AS "d1", NULL AS "dc", NULL AS "n", 1 AS "lv", NULL AS "g2", NULL AS "g3", NULL AS "d2", NULL AS "d3", NULL AS "ox", "m0", "m1" FROM agg WHERE gid = 6 AND s1 IS NOT NULL
UNION ALL
SELECT 'rowtot' AS "kind", ri AS "ri", NULL AS "gi", NULL AS "ci", NULL AS "d0", NULL AS "d1", NULL AS "dc", NULL AS "n", NULL AS "lv", NULL AS "g2", NULL AS "g3", NULL AS "d2", NULL AS "d3", NULL AS "ox", "m0", "m1" FROM agg WHERE gid = 3 AND ri IS NOT NULL
UNION ALL
SELECT 'coltot' AS "kind", NULL AS "ri", NULL AS "gi", ci AS "ci", NULL AS "d0", NULL AS "d1", NULL AS "dc", NULL AS "n", NULL AS "lv", NULL AS "g2", NULL AS "g3", NULL AS "d2", NULL AS "d3", NULL AS "ox", "m0", "m1" FROM agg WHERE gid = 5 AND ci IS NOT NULL
UNION ALL
SELECT 'grand' AS "kind", NULL AS "ri", NULL AS "gi", NULL AS "ci", NULL AS "d0", NULL AS "d1", NULL AS "dc", NULL AS "n", NULL AS "lv", NULL AS "g2", NULL AS "g3", NULL AS "d2", NULL AS "d3", NULL AS "ox", "m0", "m1" FROM agg WHERE gid = 7)
SELECT u."kind", u."ri", u."gi", u."ci", u."d0", u."d1", u."dc", u."n", u."lv", u."g2", u."g3", u."d2", u."d3", u."ox", u."m0" AS "m0", CASE WHEN CASE u.kind WHEN 'cell' THEN ct."m1" WHEN 'sub' THEN ct."m1" WHEN 'coltot' THEN u."m1" ELSE gt."m1" END IS NULL OR CASE u.kind WHEN 'cell' THEN ct."m1" WHEN 'sub' THEN ct."m1" WHEN 'coltot' THEN u."m1" ELSE gt."m1" END = 0 THEN NULL ELSE CAST(u."m1" AS DOUBLE) / CAST(CASE u.kind WHEN 'cell' THEN ct."m1" WHEN 'sub' THEN ct."m1" WHEN 'coltot' THEN u."m1" ELSE gt."m1" END AS DOUBLE) END AS "m1" FROM u CROSS JOIN gt LEFT JOIN ct ON u.kind IN ('cell', 'sub') AND ct.ci = u.ci",
    },
  ],
}
`;

