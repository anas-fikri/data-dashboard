      "params": {
        "f1": "Bandung",
        "path": "/tmp/t073-legacy.parquet",
      },
      "sql": "SELECT count(DISTINCT lower(left("c1", 500))) + coalesce(max(CASE WHEN lower(left("c1", 500)) IS NULL THEN 1 ELSE 0 END), 0) AS n,
  coalesce(sum("c2"), 0) AS t
FROM read_parquet($path)
WHERE (lower("c1") IN (lower($f1)) OR "c1" IS NULL)",
    },
  ],
}
`;

