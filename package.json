{
  "name": "data-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high --omit=dev && npm audit --audit-level=critical",
    "check": "npm run lint && npm run typecheck && npm run test && npm run audit",
    "perf": "node scripts/perf.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:generate": "prisma generate",
    "compose:up": "docker compose -f docker-compose.dev.yml up -d && node scripts/storage-init.mjs",
    "storage:init": "node scripts/storage-init.mjs",
    "compose:down": "docker compose -f docker-compose.dev.yml down",
    "secrets:dev": "node scripts/gen-dev-env.mjs",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/index.ts",
    "fixtures": "tsx scripts/fixtures/build-committed.ts"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.12.0",
    "@tabler/icons-react": "^3.49.0",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "6.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pino": "^9.14.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "2.2.4",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "prisma": "6.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
