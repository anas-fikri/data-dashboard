// Metadata saja. Data tabular hidup di Parquet (ADR-0001), bukan di PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  /// argon2id; null untuk akun seed sampai user menetapkan password (T-002/T-026).
  passwordHash    String?
  isAdmin         Boolean   @default(false)
  isActive        Boolean   @default(true)
  /// Dinaikkan untuk mencabut semua sesi (nonaktif, ganti password, cabut admin). Lihat D1.
  sessionVersion  Int       @default(1)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tokens    VerificationToken[]
  datasets  Dataset[]
  uploads   DatasetVersion[]    @relation("VersionUploader")
  auditLogs AuditLog[]          @relation("AuditActor")

  @@index([isActive, isAdmin])
  @@index([emailVerifiedAt, createdAt])
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Token sekali pakai (verifikasi email, reset password). Hanya hash SHA-256 yang disimpan.
model VerificationToken {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose             TokenPurpose
  tokenHash           String       @unique
  /// Hash password milik pendaftar yang meminta token ini; diterapkan saat token dipakai
  /// (mencegah pre-account takeover: pendaftar lain tidak bisa "menitipkan" password-nya).
  pendingPasswordHash String?
  /// Nama tampilan dari pendaftar token ini; diterapkan saat aktivasi.
  pendingName         String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Status versi data (flow-kerja B5). Terminal: READY, FAILED.
enum VersionStatus {
  UPLOADING
  UPLOADED
  INGESTING
  AWAITING_MAPPING
  READY
  FAILED
}

enum VersionMode {
  REPLACE
  APPEND
}

/// Profil dataset: kontainer untuk versi data dan dashboard. Label (kosong/siap) diturunkan,
/// bukan disimpan (B5).
model Dataset {
  id              String           @id @default(cuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  /// Nama ternormalisasi (trim + lowercase) untuk keunikan per pemilik tanpa peka kapital.
  nameKey         String
  description     String?
  activeVersionId String?          @unique
  activeVersion   DatasetVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions        DatasetVersion[] @relation("DatasetVersions")
  dashboards      Dashboard[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([ownerId, nameKey])
  @@index([ownerId, updatedAt])
}

model DatasetVersion {
  id               String        @id @default(cuid())
  datasetId        String
  dataset          Dataset       @relation("DatasetVersions", fields: [datasetId], references: [id], onDelete: Cascade)
  activeFor        Dataset?      @relation("ActiveVersion")
  status           VersionStatus @default(UPLOADING)
  mode             VersionMode   @default(REPLACE)
  originalName     String?
  sizeBytes        BigInt?
  sourceKey        String?
  etag             String?
  sha256           String?
  errorMessage     String?
  ingestFinishedAt DateTime?
  /// File asli (raw/<ds>/<ver>/) sudah dihapus job retensi 7 hari (T-013). sourceKey sengaja tetap:
  /// recast menurunkan jenis sumber (csv/xlsx) dari ekstensinya.
  sourceDeletedAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Upload multipart (T-004, flow-kerja B2)
  uploadedById String?
  uploadedBy   User?     @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  /// SHA-256 dari fingerprint klien (nama + ukuran + lastModified); resume hanya dalam (uploadedById, datasetId).
  fingerprint  String?
  /// UploadId multipart di object storage; null setelah complete/abort.
  uploadId     String?
  partSize     Int?
  partCount    Int?
  /// Klaim complete (cegah dua complete bersamaan); kedaluwarsa setelah 5 menit.
  completingAt DateTime?

  // Ingest (T-006, flow-kerja B3)
  ingestStartedAt DateTime?
  /// Tahap ingest terakhir yang selesai: "typed" (raw + typed semua sheet tertulis, versi READY).
  ingestStage     String?
  /// Progres untuk UI: { sheet, sheetCount, sheetName, rows, fraction, at } (ditulis tiap ≤ 5 detik).
  progress        Json?
  sheets          Sheet[]

  @@index([datasetId, createdAt])
  @@index([status])
  @@index([datasetId, status])
  @@index([uploadedById, status])
}

/// Satu sheet hasil ingest (B3). raw.parquet posisional: c1..cN VARCHAR + _row (nomor baris fisik).
/// Header adalah metadata (headerRow + peta nama), bukan bagian data: memilih ulang header tidak
/// mem-parse ulang file asli (T-008).
model Sheet {
  id             String         @id @default(cuid())
  versionId      String
  version        DatasetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// Urutan sheet di workbook (0-based); CSV selalu 0.
  index          Int
  name           String
  /// Nama sheet aktif yang dipasangkan pengguna saat pemetaan (T-014, sheet yang ganti nama): widget,
  /// rollback, dan remap tetap mencocokkan sheet ini lewat nama tersebut. null = tidak ada.
  aliasName      String?
  rawKey         String
  /// Jumlah baris yang tersimpan di raw.parquet (baris kosong tidak disimpan).
  rawRows        Int
  colCount       Int
  /// Nomor baris fisik header (1-based) hasil tebakan; bisa dikoreksi user (T-008).
  headerRow      Int
  /// [{ pos, name, original }] — nama unik deterministik + nama asli apa adanya.
  columns        Json
  /// Sel yang dipotong karena > 32.767 karakter.
  truncatedCells Int            @default(0)
  /// Pratinjau baris mentah awal untuk memilih baris header (T-008): SheetPreview
  /// (src/features/ingest/preview.ts), ≤ 30 baris × 50 kolom, sel ≤ 100 karakter. null = data lama.
  preview        Json?
  /// typed-<schemaRevision>.parquet aktif (T-007); diganti setelah recast selesai lengkap.
  typedKey       String?
  /// 0 = belum ada typed; 1 = hasil inferensi; naik setiap recast (T-008).
  schemaRevision Int            @default(0)
  /// ColumnSchema[] (src/features/ingest/infer.ts): nama tampil/asli, tipe, locale, format, statistik.
  schema         Json?
  createdAt      DateTime       @default(now())

  @@unique([versionId, index])
}

/// Prefix storage yang menunggu dihapus: gagal dihapus (review T-003 #2) atau milik versi yang
/// dibuang retensi (T-013, ditunda ≥ 1 jam agar query yang sedang berjalan selesai). Diproses job
/// pembersihan di worker; baris dihapus setelah berhasil.
model StorageCleanup {
  id        String   @id @default(cuid())
  prefix    String
  reason    String
  attempts  Int      @default(0)
  /// Tidak diproses sebelum waktu ini (masa tenggang retensi / backoff setelah gagal).
  notBefore DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([notBefore])
}

/// Dashboard minimal (T-003: agar hapus kaskade teruji). Kolom builder ditambah di T-010.
model Dashboard {
  id             String   @id @default(cuid())
  datasetId      String
  dataset        Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name           String
  /// Nama ternormalisasi (trim + lowercase): unik per dataset tanpa peka kapital.
  nameKey        String
  /// Posisi widget di grid 12 kolom: [{ i: widgetId, x, y, w, h }] (T-010).
  layout         Json     @default("[]")
  /// Naik tiap layout/widget berubah; simpan otomatis memakai CAS agar tab lama tidak menimpa.
  layoutRevision Int      @default(0)
  /// Kolom filter global (T-012): [{ sheet, column }] dengan nama tampil, ≤ 8, unik. Pengguna dashboard
  /// hanya boleh memfilter kolom ini + dimensi grafik yang cross-filter-nya aktif (D6).
  filterColumns  Json     @default("[]")
  widgets        Widget[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([datasetId, nameKey])
  @@index([datasetId])
}

/// Isi widget (T-010: kosong; T-011: tabel/KPI/grafik). Posisi ada di Dashboard.layout.
model Widget {
  id             String    @id @default(cuid())
  dashboardId    String
  dashboard      Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  type           String    @default("empty")
  title          String    @default("")
  spec           Json      @default("{}")
  /// Nama kolom lama yang tidak ditemukan saat versi diaktifkan (T-013): spec dibiarkan menunjuk sheet
  /// lama; setelah sheet itu dihapus retensi, pesan "kolom tidak ada" tetap bisa menyebut namanya.
  /// Kosong = spec cocok dengan versi aktif. Dikosongkan saat user menyimpan pengaturan widget.
  missingColumns String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([dashboardId])
}

/// Jejak tindakan sensitif (D14): admin (T-019), berbagi/hapus/ekspor (T-016, T-017). Hanya ditambah,
/// tidak pernah diubah. actorId null bila akun pelaku dihapus; targetId sengaja tanpa FK agar jejak
/// tetap ada setelah objeknya hilang.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Mis. "user.admin.grant", "user.deactivate", "datasets.transfer".
  action     String
  /// Jenis objek sasaran, mis. "user".
  targetType String
  targetId   String
  /// Detail tambahan tanpa rahasia (mis. { from, to, moved, renamed }).
  meta       Json?
  /// clientIp(): "local" di dev tanpa proxy tepercaya.
  ip         String
  at         DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([at])
}
