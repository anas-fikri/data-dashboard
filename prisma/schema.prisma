// Metadata saja. Data tabular hidup di Parquet (ADR-0001), bukan di PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  /// argon2id; null untuk akun seed sampai user menetapkan password (T-002/T-026).
  passwordHash    String?
  isAdmin         Boolean   @default(false)
  isActive        Boolean   @default(true)
  /// Dinaikkan untuk mencabut semua sesi (nonaktif, ganti password, cabut admin). Lihat D1.
  sessionVersion  Int       @default(1)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tokens          VerificationToken[]
  datasets        Dataset[]
  uploads         DatasetVersion[]    @relation("VersionUploader")
  /// Segmen periode yang diunggah user ini (T-056, kartu Periode "Diunggah oleh").
  segmentUploads  Segment[]           @relation("SegmentUploader")
  auditLogs       AuditLog[]          @relation("AuditActor")
  /// Dashboard yang dibagikan ke user ini (T-016).
  dashboardShares DashboardShare[]    @relation("DashboardShareUser")
  /// Pemberian akses yang dibuat user ini (T-016).
  sharesGranted   DashboardShare[]    @relation("DashboardShareGranter")
  /// Ekspor milik user ini (T-017/T-018); objek exports/<userId>/ dibersihkan job ekspor.
  exports         Export[]
  guideReads      GuideRead[]
  /// Pivot tersimpan yang dibuat user ini (T-072); SetNull bila akun dihapus.
  savedPivots     SavedPivot[]        @relation("SavedPivotCreator")

  @@index([isActive, isAdmin])
  @@index([emailVerifiedAt, createdAt])
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Token sekali pakai (verifikasi email, reset password). Hanya hash SHA-256 yang disimpan.
model VerificationToken {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose             TokenPurpose
  tokenHash           String       @unique
  /// Hash password milik pendaftar yang meminta token ini; diterapkan saat token dipakai
  /// (mencegah pre-account takeover: pendaftar lain tidak bisa "menitipkan" password-nya).
  pendingPasswordHash String?
  /// Nama tampilan dari pendaftar token ini; diterapkan saat aktivasi.
  pendingName         String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Status versi data (flow-kerja B5). Terminal: READY, FAILED.
enum VersionStatus {
  UPLOADING
  UPLOADED
  INGESTING
  AWAITING_MAPPING
  /// Unggahan periode menunggu keputusan pemilik di layar tinjauan (T-049): non-terminal seperti
  /// AWAITING_MAPPING (menahan unggahan lain dan rollback).
  AWAITING_CONFIRM
  READY
  FAILED
}

/// Jenis versi (T-049, rencana G-6 §4.3). REPLACE = ganti semua data (non-periode); PERIOD = unggahan
/// periode; PERIOD_SETUP = aktifkan mode periode atas data yang ada; PERIOD_REMOVE / PERIOD_RESTORE =
/// hapus / pulihkan satu periode (hanya manifest). APPEND (T-015) dihapus.
enum VersionMode {
  REPLACE
  PERIOD
  PERIOD_SETUP
  PERIOD_REMOVE
  PERIOD_RESTORE
}

/// Satuan periode (T-049): minggu/hari sengaja tidak ada di v1 (rencana G-6 §4.4).
enum PeriodGrain {
  MONTH
  QUARTER
  YEAR
}

/// Sumber periode satu sheet (T-049): kolom tanggal typed, atau label yang dipilih saat unggah.
enum PeriodSource {
  COLUMN
  LABEL
}

/// Saat batas periode tercapai (T-051, rencana G-6 §5.3): tolak unggahan (bawaan) atau lepas periode
/// terlama otomatis (selalu lewat tinjauan).
enum PeriodOnLimit {
  REJECT
  EVICT_OLDEST
}

/// Profil dataset: kontainer untuk versi data dan dashboard. Label (kosong/siap) diturunkan,
/// bukan disimpan (B5).
model Dataset {
  id              String           @id @default(cuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  /// Nama ternormalisasi (trim + lowercase) untuk keunikan per pemilik tanpa peka kapital.
  nameKey         String
  description     String?
  /// "Simpan N periode terbaru" (T-051); null = bawaan admin PERIOD_KEEP_DEFAULT, ≤ PERIOD_KEEP_MAX
  /// (ditegakkan aplikasi). Pengaturan dataset, bukan mode: mode periode milik versi/sheet.
  keepPeriods     Int?
  /// Perilaku saat batas periode tercapai (T-051).
  onLimit         PeriodOnLimit    @default(REJECT)
  activeVersionId String?          @unique
  activeVersion   DatasetVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions        DatasetVersion[] @relation("DatasetVersions")
  dashboards      Dashboard[]
  lineages        SheetLineage[]
  segments        Segment[]
  uploadQueues    UploadQueue[]
  /// Pivot tersimpan dataset ini (T-072, ADR-0009); ikut terhapus bersama dataset.
  savedPivots     SavedPivot[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([ownerId, nameKey])
  @@index([ownerId, updatedAt])
}

model DatasetVersion {
  id               String        @id @default(cuid())
  datasetId        String
  dataset          Dataset       @relation("DatasetVersions", fields: [datasetId], references: [id], onDelete: Cascade)
  activeFor        Dataset?      @relation("ActiveVersion")
  status           VersionStatus @default(UPLOADING)
  mode             VersionMode   @default(REPLACE)
  /// Satuan periode versi ini (T-049); null = versi non-periode. Mode periode milik versi (bukan
  /// dataset): rollback ke versi sebelum periode diaktifkan mengembalikan dataset ke mode biasa.
  periodGrain      PeriodGrain?
  /// Rencana periode yang dibekukan (T-050, PeriodPlan v1 di src/features/ingest/period-plan.ts):
  /// periode ditambah/diganti/dilepas/dikecualikan + baris sebelum → sesudah. Hanya ditulis selama
  /// versi non-terminal; null = versi non-periode atau belum direncanakan.
  plan             Json?
  /// Versi aktif yang dilihat pemilik saat init unggahan periode (T-052); berbeda dengan versi aktif
  /// saat file diproses → tidak aktif otomatis (tinjauan). Bukan relasi: versi dasar boleh dibuang.
  baseVersionId    String?
  /// Awal periode pilihan pemilik untuk sheet bersumber label (T-052, naive D8); null = tanpa label.
  periodLabel      DateTime?     @db.Date
  /// Kelompok file satu periode (T-060): [{ seq, key, name, size }] file sumber kelompok, semuanya di
  /// raw/<ds>/<versionId>/ (retensi/pembersihan prefix versi berlaku apa adanya). null = satu file
  /// (sourceKey). sourceKey = file pertama kelompok.
  groupFiles       Json?
  /// Fakta unggahan periode di luar rencana (T-057): { ignoredSheets: string[], changes:
  /// SheetSchemaChange[] } — sheet file yang tidak disimpan (dipakai lagi setelah pemetaan) dan
  /// perubahan skema sheet (kolom tersembunyi baru, alias judul) yang dibawa ke versi ini saat commit.
  periodMeta       Json?
  /// Sheet xlsx yang dipilih pemilik saat unggah (T-85tb), nama persis; kosong = semua sheet (perilaku
  /// lama, CSV, mode PERIOD). Worker hanya membaca sheet ini; sheet aktif yang tidak dipilih masuk
  /// alur pemetaan biasa (tidak dipakai lagi).
  selectedSheets   String[]      @default([])
  originalName     String?
  sizeBytes        BigInt?
  sourceKey        String?
  etag             String?
  sha256           String?
  errorMessage     String?
  ingestFinishedAt DateTime?
  /// File asli (raw/<ds>/<ver>/) sudah dihapus job retensi 7 hari (T-013). sourceKey sengaja tetap:
  /// recast menurunkan jenis sumber (csv/xlsx) dari ekstensinya.
  sourceDeletedAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Upload multipart (T-004, flow-kerja B2)
  uploadedById String?
  uploadedBy   User?     @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  /// SHA-256 dari fingerprint klien (nama + ukuran + lastModified); resume hanya dalam (uploadedById, datasetId).
  fingerprint  String?
  /// UploadId multipart di object storage; null setelah complete/abort.
  uploadId     String?
  partSize     Int?
  partCount    Int?
  /// Klaim complete (cegah dua complete bersamaan); kedaluwarsa setelah 5 menit.
  completingAt DateTime?

  // Ingest (T-006, flow-kerja B3)
  ingestStartedAt DateTime?
  /// Tahap ingest terakhir yang selesai: "typed" (raw + typed semua sheet tertulis, versi READY).
  ingestStage     String?
  /// Progres untuk UI: { sheet, sheetCount, sheetName, rows, fraction, at } (ditulis tiap ≤ 5 detik).
  progress        Json?
  sheets          Sheet[]
  /// Segmen yang ditulis versi ini (ADR-0008); ikut terhapus bersama versinya selama segmen hanya
  /// dirujuk versi pembuatnya (REPLACE). GC berbasis referensi menggantikannya di T-038.
  segments        Segment[]

  @@index([datasetId, createdAt])
  @@index([status])
  @@index([datasetId, status])
  @@index([uploadedById, status])
}

/// Satu sheet hasil ingest (B3). raw.parquet posisional: c1..cN VARCHAR + _row (nomor baris fisik).
/// Header adalah metadata (headerRow + peta nama), bukan bagian data: memilih ulang header tidak
/// mem-parse ulang file asli (T-008).
model Sheet {
  id             String         @id @default(cuid())
  versionId      String
  version        DatasetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// Urutan sheet di workbook (0-based); CSV selalu 0.
  index          Int
  name           String
  /// Nama sheet aktif yang dipasangkan pengguna saat pemetaan (T-014, sheet yang ganti nama): widget,
  /// rollback, dan remap tetap mencocokkan sheet ini lewat nama tersebut. null = tidak ada.
  aliasName      String?
  rawKey         String
  /// Jumlah baris yang tersimpan di raw.parquet (baris kosong tidak disimpan).
  rawRows        Int
  colCount       Int
  /// Nomor baris fisik header (1-based) hasil tebakan; bisa dikoreksi user (T-008).
  headerRow      Int
  /// [{ pos, name, original }] — nama unik deterministik + nama asli apa adanya.
  columns        Json
  /// Sel yang dipotong karena > 32.767 karakter.
  truncatedCells Int            @default(0)
  /// Pratinjau baris mentah awal untuk memilih baris header (T-008): SheetPreview
  /// (src/features/ingest/preview.ts), ≤ 30 baris × 50 kolom, sel ≤ 100 karakter. null = data lama.
  preview        Json?
  /// typed-<schemaRevision>.parquet aktif (T-007); diganti setelah recast selesai lengkap.
  typedKey       String?
  /// 0 = belum ada typed; 1 = hasil inferensi; naik setiap recast (T-008).
  schemaRevision Int            @default(0)
  /// ColumnSchema[] (src/features/ingest/infer.ts): nama tampil/asli, tipe, locale, format, statistik.
  schema         Json?
  /// Identitas sheet logis lintas versi (ADR-0008, T-036): dibawa dari sheet aktif yang berpasangan
  /// (ingest refresh, pemetaan user); sumber rowBase segmen.
  lineageId      String
  lineage        SheetLineage   @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  /// Sumber periode sheet ini (T-049); null = sheet non-periode. Wajib diisi di versi periode.
  periodSource   PeriodSource?
  /// Posisi kanonik kolom periode (c<pos>) bila periodSource = COLUMN: tipe/format kolom ini dibekukan.
  periodColumn   Int?
  /// Manifest data sheet ini: daftar segmen typed berurutan (REPLACE: tepat satu, ordinal 0).
  segments       SheetSegment[]
  createdAt      DateTime       @default(now())

  @@unique([versionId, index])
  @@index([lineageId])
}

/// Sheet logis lintas versi (ADR-0008). `rowHighWater` = batas atas `_row` yang pernah dibagikan ke
/// segmen sheet ini: segmen baru mendapat rowBase = nilai lama, lalu nilainya naik atomik sebesar baris
/// fisik terbesar segmen — `_row` unik per sheet logis dan tidak pernah dipakai ulang. Lineage hasil
/// migrasi T-036 mulai dari 2^31 − 1 (typed lama ber-`_row INTEGER` = baris fisik).
model SheetLineage {
  id           String    @id @default(cuid())
  datasetId    String
  dataset      Dataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  rowHighWater BigInt    @default(0)
  sheets       Sheet[]
  segments     Segment[]
  createdAt    DateTime  @default(now())

  @@index([datasetId])
}

/// Segmen data imutabel satu sheet logis (ADR-0008): raw.parquet + typed per revisi skema
/// (SegmentTyped). Typed baru: `_row BIGINT = rowBase + baris fisik`, `_src_row` = baris fisik,
/// c<pos> kanonik. Segmen legacy (migrasi T-036) merujuk kunci lama di prefix versi tanpa disalin.
model Segment {
  id                 String          @id @default(cuid())
  datasetId          String
  dataset            Dataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  lineageId          String
  lineage            SheetLineage    @relation(fields: [lineageId], references: [id], onDelete: Cascade)
  rowBase            BigInt          @default(0)
  /// Baris fisik terbesar di raw (null = segmen legacy yang belum diukur).
  maxSrcRow          Int?
  rawKey             String
  rawRows            Int
  /// Ukuran raw.parquet di storage (T-039 kuota); null = segmen lama yang belum diukur.
  rawBytes           BigInt?
  /// Baris judul saat segmen ditulis (imutabel, T-gcn8). Judul yang berlaku untuk satu file typed ada
  /// di SegmentTyped.headerRow — segmen bisa dibagi beberapa versi dengan judul berbeda.
  headerRow          Int
  /// Kolom raw di file ini (c1..c<colCount>).
  colCount           Int
  /// Peta kolom (T-gcn8): colMap[pos-1] = indeks kolom raw `c<n>` untuk posisi kanonik `pos`
  /// (0 = kolom tidak ada di file → NULL). Kosong = identitas (raw `c<pos>` = posisi kanonik).
  colMap             Int[]           @default([])
  /// Kunci periode (T-049): "2026-03" (bulan), "2026-Q1" (kuartal), "2026" (tahun); null = segmen
  /// non-periode. Satu segmen = satu periode; `_period` di typed = periodStart (dibekukan saat unggah).
  periodKey          String?
  /// Tanggal awal periode (naive, D8); null = segmen non-periode.
  periodStart        DateTime?       @db.Date
  /// Tanggal terkecil/terbesar kolom periode di segmen (naive): pemangkasan segmen saat filter tanggal.
  /// Sheet berlabel (T-054): kolom tanggal acuan (labelReferenceColumn) — hanya info tinjauan.
  minDate            DateTime?       @db.Timestamp(6)
  maxDate            DateTime?       @db.Timestamp(6)
  /// SHA-256 file asal segmen (deteksi "file identik"); null = tidak diketahui.
  sha256             String?
  /// Nama file asal (kartu Periode, sumber sel); null = tidak diketahui.
  originalName       String?
  /// Jenis file asal: "xlsx" | "csv" (cast per segmen memakai jenisnya sendiri); null = tidak diketahui.
  sourceKind         String?
  /// Pengunggah file asal segmen (T-056, kartu Periode "Diunggah oleh"): bertahan walau versi
  /// pembuatnya dibuang retensi. SetNull bila akunnya dihapus; null = tidak diketahui.
  uploadedById       String?
  uploadedBy         User?           @relation("SegmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Kelompok file satu periode (T-060, rencana G-6 §4.6 P-28): id kelompok (= id versi unggahan
  /// kelompok; bukan relasi, bertahan walau versinya dibuang retensi), nomor file 1..n di kelompok, dan
  /// jumlah segmen kelompok ini di periode + sheet logis yang sama. null = segmen dari satu file. Satu
  /// periode boleh punya > 1 segmen di satu sheet HANYA bila semuanya satu kelompok lengkap (gerbang
  /// integritas, src/features/versions/integrity-check.ts) — bukan append buta.
  groupId            String?
  groupPart          Int?
  groupSize          Int?
  /// Versi yang menulis segmen ini. SetNull (T-038): segmen tidak ikut terhapus bersama versinya —
  /// objeknya dihapus GC mark-and-sweep setelah tidak dirujuk versi hidup ≥ SEGMENT_GC_GRACE_HOURS.
  createdByVersionId String?
  createdByVersion   DatasetVersion? @relation(fields: [createdByVersionId], references: [id], onDelete: SetNull)
  /// Tanda GC (T-038): sejak kapan segmen ini tidak dirujuk versi hidup; null = dirujuk.
  unreferencedAt     DateTime?
  typed              SegmentTyped[]
  createdAt          DateTime        @default(now())

  @@index([datasetId])
  @@index([lineageId])
  @@index([createdByVersionId])
}

/// Satu file typed segmen untuk satu revisi skema (recast menulis file baru → baris baru).
model SegmentTyped {
  id             String         @id @default(cuid())
  segmentId      String
  segment        Segment        @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  schemaRevision Int
  typedKey       String
  /// File typed lama (sebelum T-036): `_row INTEGER` = baris fisik, tanpa `_src_row`.
  legacyRow      Boolean        @default(false)
  /// Posisi c<pos> yang ada di file (T-037): kelompok skema untuk proyeksi eksplisit saat segmen satu
  /// sheet berbeda kolom (NULL AS c<pos> untuk yang tidak punya).
  columns        Int[]          @default([])
  /// Baris data di file (dihitung dari raw saat ditulis, T-038); null = file lama (belum diukur).
  dataRows       Int?
  /// Ukuran file typed di storage (T-039 kuota); null = file lama yang belum diukur.
  typedBytes     BigInt?
  /// Profil raw segmen untuk baris judul file ini (T-040, src/features/ingest/profile.ts): recast per
  /// segmen memutuskan tipe dari gabungan profil tanpa memindai ulang raw; null = file lama.
  profile        Json?
  /// Baris judul yang dipakai file ini (T-gcn8); null = Segment.headerRow (file sebelum T-gcn8).
  headerRow      Int?
  /// Tanda GC (T-038): sejak kapan revisi ini tidak dirujuk manifest versi hidup; null = dirujuk.
  unreferencedAt DateTime?
  sheets         SheetSegment[]
  createdAt      DateTime       @default(now())

  @@index([segmentId])
}

/// Manifest versi (ADR-0008): segmen typed yang membentuk data sheet, urut `ordinal`.
model SheetSegment {
  sheetId        String
  sheet          Sheet        @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  segmentTypedId String
  /// NoAction: diperiksa di akhir statement, jadi hapus dataset (cascade ke sheet dan segmen) tetap
  /// jalan, tetapi menghapus file typed yang masih dirujuk manifest gagal (bukan diam-diam rusak).
  segmentTyped   SegmentTyped @relation(fields: [segmentTypedId], references: [id], onDelete: NoAction)
  ordinal        Int

  @@id([sheetId, ordinal])
  @@index([segmentTypedId])
}

/// Prefix storage yang menunggu dihapus: gagal dihapus (review T-003 #2) atau milik versi yang
/// dibuang retensi (T-013, ditunda ≥ 1 jam agar query yang sedang berjalan selesai). Diproses job
/// pembersihan di worker; baris dihapus setelah berhasil.
model StorageCleanup {
  id        String   @id @default(cuid())
  prefix    String
  reason    String
  attempts  Int      @default(0)
  /// Tidak diproses sebelum waktu ini (masa tenggang retensi / backoff setelah gagal).
  notBefore DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([notBefore])
}

/// Dashboard minimal (T-003: agar hapus kaskade teruji). Kolom builder ditambah di T-010.
model Dashboard {
  id             String           @id @default(cuid())
  datasetId      String
  dataset        Dataset          @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name           String
  /// Nama ternormalisasi (trim + lowercase): unik per dataset tanpa peka kapital.
  nameKey        String
  /// Posisi widget di grid 12 kolom: [{ i: widgetId, x, y, w, h }] (T-010).
  layout         Json             @default("[]")
  /// Naik tiap layout/widget berubah; simpan otomatis memakai CAS agar tab lama tidak menimpa.
  layoutRevision Int              @default(0)
  /// Kolom filter global (T-012): [{ sheet, column }] dengan nama tampil, ≤ 8, unik. Pengguna dashboard
  /// hanya boleh memfilter kolom ini + dimensi grafik yang cross-filter-nya aktif (D6).
  filterColumns  Json             @default("[]")
  /// Dibagikan ke seluruh organisasi (semua user aktif) sebagai VIEWER (T-016; tabel peran flow-kerja).
  orgShared      Boolean          @default(false)
  shares         DashboardShare[]
  widgets        Widget[]
  exports        Export[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([datasetId, nameKey])
  @@index([datasetId])
}

/// Isi widget (T-010: kosong; T-011: tabel/KPI/grafik). Posisi ada di Dashboard.layout.
model Widget {
  id             String      @id @default(cuid())
  dashboardId    String
  dashboard      Dashboard   @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  type           String      @default("empty")
  title          String      @default("")
  spec           Json        @default("{}")
  /// Nama kolom lama yang tidak ditemukan saat versi diaktifkan (T-013): spec dibiarkan menunjuk sheet
  /// lama; setelah sheet itu dihapus retensi, pesan "kolom tidak ada" tetap bisa menyebut namanya.
  /// Kosong = spec cocok dengan versi aktif. Dikosongkan saat user menyimpan pengaturan widget.
  missingColumns String[]    @default([])
  /// Pivot tersimpan yang menjadi sumber widget ini (ADR-0009; diikat T-073). NoAction: dicek di akhir
  /// statement, jadi hapus dataset yang meng-cascade dashboard → widget dan pivot tersimpan sekaligus
  /// tidak gagal; hapus pivot tersimpan yang masih dirujuk ditolak aplikasi (IN_USE) dan oleh FK ini.
  savedPivotId   String?
  savedPivot     SavedPivot? @relation(fields: [savedPivotId], references: [id], onDelete: NoAction)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([dashboardId])
  @@index([savedPivotId])
}

/// Pivot tersimpan (T-072, ADR-0009): definisi pivot tingkat dataset yang bisa menjadi sumber banyak
/// widget. Spec = spec widget pivot (skema zod yang sama, kolom c<pos> sheet versi aktif). Baca/tulis
/// pemilik dataset; editor dashboard dataset itu hanya baca. Dipetakan ulang saat aktivasi/rollback
/// versi di transaksi yang sama dengan widget (versions/activation.ts).
model SavedPivot {
  id             String   @id @default(cuid())
  datasetId      String
  dataset        Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name           String
  /// Nama ternormalisasi (nameKeyOf): unik per dataset tanpa peka kapital.
  nameKey        String
  spec           Json
  /// Seperti Widget.missingColumns: nama kolom lama yang tidak ditemukan saat versi diaktifkan.
  missingColumns String[] @default([])
  /// Naik tiap simpan (juga saat remap versi menulisnya): CAS simpan + masukan kunci cache (T-073).
  revision       Int      @default(1)
  createdById    String?
  createdBy      User?    @relation("SavedPivotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  widgets        Widget[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([datasetId, nameKey])
}

/// Jejak tindakan sensitif (D14): admin (T-019), berbagi/hapus/ekspor (T-016, T-017). Hanya ditambah,
/// tidak pernah diubah. actorId null bila akun pelaku dihapus; targetId sengaja tanpa FK agar jejak
/// tetap ada setelah objeknya hilang.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Mis. "user.admin.grant", "user.deactivate", "datasets.transfer".
  action     String
  /// Jenis objek sasaran, mis. "user".
  targetType String
  targetId   String
  /// Detail tambahan tanpa rahasia (mis. { from, to, moved, renamed }).
  meta       Json?
  /// clientIp(): "local" di dev tanpa proxy tepercaya.
  ip         String
  at         DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([at])
}

/// Peran akses dashboard bagi non-pemilik (T-016). Pemilik dataset selalu OWNER (tidak disimpan).
enum DashboardRole {
  VIEWER
  EDITOR
}

/// Akses dashboard untuk satu user (T-016). Satu baris per (dashboard, user); akses organisasi ada di
/// Dashboard.orgShared. Dihapus ikut dashboard/user.
model DashboardShare {
  id          String        @id @default(cuid())
  dashboardId String
  dashboard   Dashboard     @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation("DashboardShareUser", fields: [userId], references: [id], onDelete: Cascade)
  role        DashboardRole
  createdById String?
  createdBy   User?         @relation("DashboardShareGranter", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([dashboardId, userId])
  @@index([userId])
}

enum ExportStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ExportFormat {
  CSV
  XLSX
  PDF
}

/// Ekspor widget/dashboard (T-017 CSV/XLSX, T-018 PDF). Status di DB (bukan antrean) agar kepemilikan,
/// kedaluwarsa, dan pembersihan deterministik: unduh hanya pemilik, berlaku sampai expiresAt
/// (selesai + 60 menit), objek exports/<userId>/<id>.<ext> dihapus job pembersihan.
model Export {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboardId  String?
  dashboard    Dashboard?   @relation(fields: [dashboardId], references: [id], onDelete: SetNull)
  /// Widget sumber (tanpa FK: widget boleh dihapus setelah ekspor dibuat).
  widgetId     String?
  /// Sheet sumber "Unduh tampilan" Lihat data (T-046; tanpa FK seperti widgetId). Terisi = ekspor
  /// tampilan grid (dashboardId/widgetId null), akses = pemilik/editor dataset sheet ini.
  sheetId      String?
  format       ExportFormat
  status       ExportStatus @default(QUEUED)
  /// Parameter permintaan (filter dashboard, urutan, requestedAt untuk preset tanggal).
  params       Json         @default("{}")
  errorCode    String?
  errorMessage String?
  key          String?
  fileName     String?
  rows         Int?
  bytes        BigInt?
  createdAt    DateTime     @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  expiresAt    DateTime?
  deletedAt    DateTime?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

/// Peran sasaran artikel panduan (T-020); ALL = semua peran.
enum GuideRole {
  OWNER
  EDITOR
  VIEWER
  ADMIN
  ALL
}

/// Halaman tempat artikel muncul sebagai bantuan kontekstual (T-022).
enum GuideContext {
  UPLOAD
  SCHEMA
  BUILDER
  /// Halaman pivot tersimpan (buat/ubah) + halaman dataset (T-7rw4).
  SAVED_PIVOT
}

enum GuideStatus {
  DRAFT
  PUBLISHED
}

/// Artikel panduan per peran (T-020): markdown disanitasi saat dirender; hanya admin yang mengubah.
model GuideArticle {
  id           String        @id @default(cuid())
  role         GuideRole
  contextKey   GuideContext?
  title        String
  slug         String        @unique
  bodyMarkdown String
  /// Urutan tampil (naik) di daftar panduan; ditukar lewat /admin/panduan.
  order        Int
  status       GuideStatus   @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  videos       GuideVideo[]
  reads        GuideRead[]

  @@index([status, role, order])
}

/// Artikel panduan yang sudah ditandai dibaca user (T-022): kartu "Mulai di sini" hilang setelah satu.
model GuideRead {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   GuideArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  readAt    DateTime     @default(now())

  @@unique([userId, articleId])
  @@index([articleId])
}

enum GuideVideoStatus {
  UPLOADING
  READY
}

/// Video panduan (T-021): mp4/webm ≤ 500 MB lewat multipart langsung ke storage; durasi dan poster PNG
/// diambil di browser. Objek: guides/videos/<id>.<ext>, guides/posters/<id>.png, takarir
/// guides/captions/<id>.vtt (T-j9j6).
model GuideVideo {
  id          String           @id @default(cuid())
  articleId   String
  article     GuideArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title       String
  /// mp4 | webm (menentukan Content-Type yang ditetapkan server).
  ext         String
  sizeBytes   BigInt
  objectKey   String           @unique
  uploadId    String?
  posterKey   String?
  /// guides/captions/<id>.vtt (takarir WebVTT, T-j9j6); null = tanpa takarir.
  captionKey  String?
  durationSec Int?
  status      GuideVideoStatus @default(UPLOADING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([articleId, status])
}

/// Antrean unggah banyak file periode (T-059, rencana G-6 §4.5 langkah 6). OPEN = masih ada file yang
/// belum selesai; paling banyak satu OPEN per dataset lewat indeks unik parsial
/// "UploadQueue_datasetId_open_key" yang hanya ada di migrasi 20261021100000_t059_upload_queue
/// (Prisma tidak bisa memodelkannya): migrasi baru tidak boleh menghapusnya (diuji queue-migration).
enum UploadQueueStatus {
  OPEN
  DONE
  CANCELLED
}

/// Status satu file antrean. WAITING = belum diunggah; UPLOADING = multipart berjalan; QUEUED = file
/// utuh di storage menunggu giliran; STARTED = versi dibuat dan sedang diproses/ditinjau; DONE/FAILED/
/// CANCELLED = selesai (hasil versi dicatat di sini, karena versinya bisa dibuang retensi kemudian).
enum UploadQueueItemState {
  WAITING
  UPLOADING
  QUEUED
  STARTED
  DONE
  FAILED
  CANCELLED
}

model UploadQueue {
  id             String            @id @default(cuid())
  datasetId      String
  dataset        Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  status         UploadQueueStatus @default(OPEN)
  /// Kelompok (T-060): semua file adalah bagian dari periode yang sama dan diproses sebagai SATU versi
  /// setelah semuanya terunggah (gagal/dibatalkan satu = seluruh kelompok tidak diproses).
  grouped        Boolean           @default(false)
  /// Id versi kelompok yang dipesan saat antrean dibuat (file sumber di raw/<ds>/<groupVersionId>/).
  groupVersionId String?           @unique
  /// "Hentikan antrean": file yang belum diproses dibatalkan; file yang sedang diproses diselesaikan
  /// dulu, lalu antrean berstatus CANCELLED.
  stoppedAt      DateTime?
  /// Ringkasan antrean yang sudah selesai disembunyikan pemilik.
  dismissedAt    DateTime?
  finishedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          UploadQueueItem[]

  @@index([datasetId, createdAt])
  @@index([status])
}

model UploadQueueItem {
  id           String               @id @default(cuid())
  queueId      String
  queue        UploadQueue          @relation(fields: [queueId], references: [id], onDelete: Cascade)
  /// Urutan proses (1..n), ditetapkan server saat antrean dibuat.
  seq          Int
  /// Id DatasetVersion yang dibuat saat giliran file ini (dipesan di depan agar file sumber langsung
  /// berada di prefix versinya: raw/<ds>/<versionId>/, sehingga retensi/pembersihan berlaku apa adanya).
  versionId    String               @unique @default(cuid())
  originalName String
  sizeBytes    BigInt
  /// lastModified klien (ms) — mencocokkan file yang dipilih ulang setelah muat ulang halaman.
  lastModified BigInt
  /// Awal periode pilihan pemilik untuk sheet bersumber label (naive D8); null = dari kolom tanggal.
  periodLabel  DateTime?            @db.Date
  /// Multipart di raw/<ds>/<versionId>/source.<ext> (kunci diturunkan dari versionId + ekstensi nama).
  uploadId     String?
  partSize     Int
  partCount    Int
  etag         String?
  /// Klaim complete (sama dengan DatasetVersion.completingAt).
  completingAt DateTime?
  state        UploadQueueItemState @default(WAITING)
  /// Keterangan hasil: alasan gagal/batal, atau ringkasan rencana periode yang diterapkan.
  message      String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([queueId, seq])
  @@index([state, updatedAt])
}
