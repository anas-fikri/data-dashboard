// Metadata saja. Data tabular hidup di Parquet (ADR-0001), bukan di PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  /// argon2id; null untuk akun seed sampai user menetapkan password (T-002/T-026).
  passwordHash    String?
  isAdmin         Boolean   @default(false)
  isActive        Boolean   @default(true)
  /// Dinaikkan untuk mencabut semua sesi (nonaktif, ganti password, cabut admin). Lihat D1.
  sessionVersion  Int       @default(1)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tokens VerificationToken[]

  @@index([isActive, isAdmin])
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Token sekali pakai (verifikasi email, reset password). Hanya hash SHA-256 yang disimpan.
model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}
